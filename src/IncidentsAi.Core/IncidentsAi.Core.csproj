<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.*" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
    <PackageReference Include="OpenAI" Version="2.8.0" />
    <PackageReference Include="Microsoft.Extensions.VectorData.Abstractions" Version="10.*" />
    <PackageReference Include="Microsoft.SemanticKernel.Connectors.Qdrant" Version="1.*-*" />
    <PackageReference Include="Qdrant.Client" Version="1.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded (not copied) so any project referencing Core gets the
         sample data automatically, with no per-project file copying to keep track of -->
    <EmbeddedResource Include="SampleData\incidents.json" />
  </ItemGroup>

</Project>
