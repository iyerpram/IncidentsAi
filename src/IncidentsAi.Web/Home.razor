@page "/"
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Incident Assistant</PageTitle>

<div style="max-width: 700px; margin: 2rem auto; font-family: sans-serif;">
    <h1>Incident Assistant</h1>
    <p>Ask a natural-language question about production incidents.</p>

    <div style="display: flex; gap: 0.5rem;">
        <input @bind="question" @bind:event="oninput" @onkeydown="OnKeyDown"
               placeholder="e.g. What caused the error spike in OrderService?"
               style="flex: 1; padding: 0.5rem;" />
        <button @onclick="AskAsync" disabled="@isLoading" style="padding: 0.5rem 1rem;">
            @(isLoading ? "Asking..." : "Ask")
        </button>
    </div>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color: red; margin-top: 1rem;">@errorMessage</p>
    }

    @if (!string.IsNullOrEmpty(answer))
    {
        <div style="margin-top: 1.5rem; padding: 1rem; background: #f5f5f5; border-radius: 6px; white-space: pre-wrap;">
            @answer
        </div>
    }
</div>

@code {
    private string question = string.Empty;
    private string? answer;
    private string? errorMessage;
    private bool isLoading;

    private sealed record AskRequest(string Question);
    private sealed record AskResponse(string Answer);

    private async Task OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await AskAsync();
    }

    private async Task AskAsync()
    {
        if (string.IsNullOrWhiteSpace(question) || isLoading)
            return;

        isLoading = true;
        errorMessage = null;
        answer = null;

        try
        {
            var client = HttpClientFactory.CreateClient("IncidentsApi");
            var response = await client.PostAsJsonAsync("/api/ask", new AskRequest(question));

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AskResponse>();
                answer = result?.Answer;
            }
            else
            {
                errorMessage = $"API returned {(int)response.StatusCode}. Is IncidentsAi.Api running?";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Could not reach the API - is it running? ({ex.Message})";
        }
        finally
        {
            isLoading = false;
        }
    }
}
